<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="CodecksFeedbackReporter.uss" />
    <ui:VisualElement class="codecks-feedback-root">
        <ui:Button name="codecks-feedback-launcher" text="Give Feedback" class="codecks-feedback-launcher" tabindex="0" />
        <ui:VisualElement name="codecks-feedback-overlay" class="codecks-feedback-overlay">
            <ui:VisualElement class="codecks-feedback-dialog">
                <ui:Label text="Send feedback" class="codecks-feedback-title" />
                <ui:Label text="Describe what happened. A screenshot is captured before this form opens when available." class="codecks-feedback-help" />
                <ui:TextField name="codecks-feedback-report" label="Feedback" multiline="true" class="codecks-feedback-report" tabindex="1" />
                <ui:DropdownField name="codecks-feedback-severity" label="Severity" choices="None,Low,High,Critical" value="None" class="codecks-feedback-severity" tabindex="2" />
                <ui:TextField name="codecks-feedback-email" label="Email (optional)" class="codecks-feedback-email" tabindex="3" />
                <ui:VisualElement class="codecks-feedback-actions">
                    <ui:Button name="codecks-feedback-send" text="Send Report" class="codecks-feedback-send" tabindex="4" />
                    <ui:Button name="codecks-feedback-cancel" text="Cancel" class="codecks-feedback-cancel" tabindex="5" />
                </ui:VisualElement>
                <ui:Label name="codecks-feedback-status" class="codecks-feedback-status" />
                <ui:Label text="Powered by Codecks" class="codecks-feedback-brand" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
